# Copy to .env and fill in. Variables set in the shell take precedence.

# An OpenRouter key, from https://openrouter.ai/keys. Without one, the app
# runs in demo mode with canned replies.
OPENROUTER_API_KEY=

# Models the composer offers, by their OpenRouter IDs, comma-separated;
# the first is the default.
# HYPERAI_MODELS=anthropic/claude-sonnet-5.5,anthropic/claude-opus-5.5,anthropic/claude-haiku-5.5
